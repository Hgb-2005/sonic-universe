{
    "name":  "sonic-universe-desktop",
    "version":  "0.47.2",
    "private":  true,
    "description":  "A quiet music companion with desktop lyrics and immersive visuals",
    "author":  "Sonic Universe",
    "main":  "desktop/main.cjs",
    "scripts":  {
                    "prestart":  "node scripts/stamp-assets.cjs \u0026\u0026 node scripts/build-now-playing.cjs",
                    "start":  "electron .",
                    "test":  "node --test tests/*.test.cjs",
                    "desktop:pack":  "electron-builder --win dir --x64",
                    "predesktop:pack":  "node scripts/stamp-assets.cjs \u0026\u0026 node scripts/build-now-playing.cjs",
                    "predesktop:build":  "node scripts/check-release.cjs \u0026\u0026 node scripts/stamp-assets.cjs \u0026\u0026 node scripts/build-now-playing.cjs",
                    "desktop:build":  "electron-builder --win nsis --x64",
                    "check:release":  "node scripts/check-release.cjs",
                    "bundle:assets":  "node scripts/bundle-assets.cjs"
                },
    "engines":  {
                    "node":  "\u003e=24"
                },
    "dependencies":  {
                         "qishui-music-api":  "0.2.2"
                     },
    "devDependencies":  {
                            "electron":  "45.3.3",
                            "electron-builder":  "26.18.0",
                            "playwright":  "1.58.2"
                        },
    "build":  {
                  "appId":  "com.sonicuniverse.desktop",
                  "productName":  "声波宇宙",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "electronDist":  "node_modules/electron/dist",
                  "files":  [
                                "desktop/**",
                                "outputs/*.html",
                                "outputs/*.js",
                                "outputs/*.css",
                                "outputs/interstellar-drift.mp3",
                                "outputs/assets/**",
                                "outputs/flight-preview.png",
                                "companion/**",
                                "package.json",
                                "!desktop/native/*.cs",
                                "!desktop/native/WallpaperHost.exe",
                                "!desktop/wallpaper.cjs",
                                "!companion/node_modules/**",
                                "!outputs/assets/reference/**",
                                "!outputs/_*"
                            ],
                  "asarUnpack":  [
                                     "desktop/native/NowPlayingHost.exe"
                                 ],
                  "win":  {
                              "target":  "nsis",
                              "icon":  "outputs/assets/sonic-icon.png",
                              "signExecutable":  false
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "include":  "build/installer.nsh",
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true
                           },
                  "artifactName":  "Sonic-Universe-${version}-${arch}.${ext}",
                  "electronLanguages":  [
                                            "zh-CN",
                                            "zh-TW",
                                            "en-US"
                                        ],
                  "compression":  "maximum",
                  "afterPack":  "build/afterPack.cjs"
              }
}
